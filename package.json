{
  "name": "visor-devtools",
  "version": "0.1.0",
  "description": "V.I.S.O.R. (Verified Inspection, Spans, Overrides & Runtime) \u2014 a local-first harness and live debugger for Claude with span-level tracing, mid-flight overrides, and real-money cost control.",
  "license": "MIT",
  "author": "Gokulakrishnan (https://www.gokulakrishnan.dev)",
  "homepage": "https://www.gokulakrishnan.dev/visor-devtools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gokulakrishnxn/visor-devtools.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "visor-devtools": "dist/cli.js",
    "vhud": "dist/cli.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "site:dev": "pnpm --filter visor-site dev",
    "site:build": "pnpm --filter visor-site build",
    "dist:mac": "pnpm build && pnpm build:electron && pnpm desktop:stage && electron-builder --projectDir release/app --mac --publish never",
    "build:electron": "tsup --config tsup.electron.config.ts",
    "desktop:stage": "node scripts/stage-desktop.mjs",
    "desktop": "pnpm build && pnpm build:electron && pnpm desktop:stage && electron release/app"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.327",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@hono/node-server": "^2.1.9",
    "@hono/node-ws": "^1.3.1",
    "@lezer/highlight": "^1.2.5",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
