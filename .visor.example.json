{
  "model": "claude-opus-5-5",
  "effort": "medium",
  "budget": { "sessionCapUsd": "5", "turnCapUsd": "1" },
  "breakpoints": [
    { "rule": "schema-change", "tool": "Edit", "path": "src/server/db/**", "action": "pause" },
    { "rule": "mcp-write", "tool": "mcp:*", "write": true, "action": "pause" },
    { "rule": "prod-deploy", "tool": "Bash", "match": "deploy.*--prod", "action": "pause" }
  ],
  "triggers": [
    { "type": "path", "pattern": "\\.env|id_rsa", "action": "block" },
    { "type": "tokens", "above": 200000, "action": "notify" }
  ],
  "straitjacket": { "enabled": "auto", "minChars": 20000 },
  "mcpServers": {
    "filesystem": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "."] },
    "github": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"] }
  }
}
